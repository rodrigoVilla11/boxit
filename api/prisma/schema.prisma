// BOX iT — schema Prisma inicial (Fase 1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Enums -----------------------------

enum Muscle {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE
  FOREARMS
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
}

enum SetType {
  NORMAL
  WARMUP
  DROP
  FAILURE
}

enum WeightUnit {
  KG
  LB
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ActivityType {
  RUN
  SWIM
  BIKE
  ROW
  WALK
  OTHER
}

enum PlanItemKind {
  ROUTINE
  ACTIVITY
  REST
}

// ------------------------- Usuarios / Auth -----------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  weightUnit   WeightUnit @default(KG)
  isAdmin      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Perfil (todo opcional: la app funciona sin cargar nada de esto)
  birthDate    DateTime? // sólo la fecha importa; se guarda a mediodía UTC
  sex          Sex?
  heightCm     Float? // para el IMC
  goalWeightKg Float? // objetivo de peso, en kg

  workouts      Workout[]
  routines      Routine[]
  refreshTokens RefreshToken[]
  exercises     Exercise[]
  bodyweights   Bodyweight[]
  activities        Activity[]
  weeklyPlans       WeeklyPlan[]
  cardioRoutines    CardioRoutine[]
  pushSubscriptions PushSubscription[]
}

// Suscripción de un dispositivo a Web Push (una por endpoint del navegador).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // guardamos el hash, nunca el token en claro
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------- Librería --------------------------

model Exercise {
  id               String    @id @default(cuid())
  name             String    @unique
  primaryMuscle    Muscle
  secondaryMuscles Muscle[]  @default([])
  equipment        Equipment
  description      String?
  videoUrl         String?
  userId           String? // null = ejercicio de la app; seteado = custom del usuario
  createdAt        DateTime  @default(now())

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineExercises RoutineExercise[]
  workoutExercises WorkoutExercise[]

  @@index([userId])
}

// ------------------------ Rutinas / Plantillas -------------------

model Routine {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]
  planItems PlanItem[] // referencias desde planes semanales

  @@index([userId])
}

model RoutineExercise {
  id           String @id @default(cuid())
  routineId    String
  exerciseId   String
  order         Int
  supersetGroup Int? // misma superserie = mismo entero (letra derivada en el front)
  targetSets    Int    @default(3)
  targetReps    Int? // objetivo de reps por serie (opcional)
  targetWeight  Float? // objetivo de peso por serie, en kg (opcional)
  restSeconds   Int? // descanso sugerido entre series (opcional)
  note          String? // nota del ejercicio en la rutina

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([routineId, order])
}

// ----------------------------- Entrenos --------------------------

model Workout {
  id          String    @id @default(cuid())
  userId      String
  title       String? // nombre opcional de la sesión ("Push pesado")
  note        String? // cómo salió el entreno
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationSec Int       @default(0)
  totalVolume Float     @default(0) // kg
  totalSets   Int       @default(0) // series completadas
  createdAt   DateTime  @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@index([userId, startedAt])
}

model WorkoutExercise {
  id         String @id @default(cuid())
  workoutId  String
  exerciseId String
  order      Int
  // Superserie: ejercicios con el mismo entero se alternan (misma letra A/B).
  // Null = ejercicio suelto. La letra se deriva en el front, no se persiste.
  supersetGroup Int?
  // Objetivos copiados de la rutina al empezar (guía durante el entreno).
  // Null en alta manual. No se recalculan si la rutina cambia después.
  targetReps   Int?
  targetWeight Float? // en kg
  restSeconds  Int?

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id])
  sets     WorkoutSet[]

  @@unique([workoutId, order])
  @@index([exerciseId]) // clave para el cálculo del "Anterior"
}

model WorkoutSet {
  id                String    @id @default(cuid())
  workoutExerciseId String
  order             Int
  type              SetType   @default(NORMAL)
  weight            Float     @default(0) // kg
  reps              Int       @default(0)
  completed         Boolean   @default(false)
  completedAt       DateTime?
  rpe               Float? // esfuerzo percibido 0–10 (opcional)
  note              String? // nota de la serie (opcional)

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, order])
}

// -------------------------- Peso corporal ------------------------

model Bodyweight {
  id         String   @id @default(cuid())
  userId     String
  weightKg   Float // siempre en kg; la UI convierte
  bodyFatPct Float? // % de grasa medido en la misma pesada (opcional)
  takenAt    DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
}

// ------------------- Actividades (cardio / resistencia) ----------
// Sesion de cardio (correr, nadar, etc.), separada del entreno de fuerza.
// Los totales (durationSec, distanceM) son la fuente autoritativa; los
// intervalos son un detalle estructurado opcional.

model Activity {
  id          String       @id @default(cuid())
  userId      String
  type        ActivityType
  label       String? // nombre opcional (ej "Fondo domingo")
  performedAt DateTime     @default(now())
  durationSec Int          @default(0)
  distanceM   Int          @default(0) // metros, unidad canonica
  note        String?
  createdAt   DateTime     @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  intervals ActivityInterval[]

  @@index([userId, performedAt])
}

model ActivityInterval {
  id          String  @id @default(cuid())
  activityId  String
  order       Int
  label       String?
  reps        Int     @default(1) // "8 x" => reps 8
  distanceM   Int? // POR repeticion (metros)
  durationSec Int? // POR repeticion (segundos)
  restSec     Int? // descanso entre repeticiones

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, order])
}

// ------------------- Plantillas de cardio ------------------------
// El equivalente a una Routine pero para cardio: una prescripción con nombre
// reutilizable en el plan semanal. Puede ser continua (sólo objetivo total,
// "30 min" o "5 km") o por intervalos ("8 × 400 m con 90 s de descanso").

model CardioRoutine {
  id                String       @id @default(cuid())
  userId            String
  name              String
  type              ActivityType
  targetDistanceM   Int? // objetivo total (metros), opcional
  targetDurationSec Int? // objetivo total (segundos), opcional
  note              String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  intervals CardioRoutineInterval[]
  planItems PlanItem[]

  @@index([userId])
}

model CardioRoutineInterval {
  id              String  @id @default(cuid())
  cardioRoutineId String
  order           Int
  label           String?
  reps            Int     @default(1) // "8 x" => reps 8
  distanceM       Int? // POR repeticion (metros)
  durationSec     Int? // POR repeticion (segundos)
  restSec         Int? // descanso entre repeticiones

  cardioRoutine CardioRoutine @relation(fields: [cardioRoutineId], references: [id], onDelete: Cascade)

  @@unique([cardioRoutineId, order])
}

// ------------------- Planes semanales de entrenamiento -----------
// Plan con nombre (varios por usuario, uno activo). Cada dia (0=lunes..6=domingo)
// tiene items: una rutina de gym, una actividad de cardio planeada, o descanso.

model WeeklyPlan {
  id        String   @id @default(cuid())
  userId    String
  name      String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlanItem[]

  @@index([userId])
}

model PlanItem {
  id                String        @id @default(cuid())
  planId            String
  dayOfWeek         Int // 0 = lunes .. 6 = domingo
  order             Int
  kind              PlanItemKind
  routineId         String?
  cardioRoutineId   String? // plantilla de cardio (opcional: el cardio puede ser suelto)
  activityType      ActivityType?
  targetDistanceM   Int? // objetivo de distancia (metros)
  targetDurationSec Int? // objetivo de tiempo (segundos)
  note              String?

  plan    WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  // Borrar una plantilla no mutila el plan: el item queda con routineId null.
  routine Routine?   @relation(fields: [routineId], references: [id], onDelete: SetNull)
  // Idem para cardio: el item sobrevive con los objetivos que ya tenía copiados.
  cardioRoutine CardioRoutine? @relation(fields: [cardioRoutineId], references: [id], onDelete: SetNull)

  @@index([planId])
}
