# TLS para BOX iT — usar DESPUÉS de obtener el certificado (ver DEPLOY.md §4).
# Reemplazá TU_DOMINIO por tu dominio real y usá este archivo como
# nginx/default.conf (o reemplazá el bloque `server { listen 80; }`).

upstream boxit_web { server web:3000; }
upstream boxit_api { server api:3001; }

# HTTP: challenge de certbot + redirección a HTTPS
server {
    listen 80;
    server_name TU_DOMINIO;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS
server {
    listen 443 ssl;
    http2 on;
    server_name TU_DOMINIO;

    client_max_body_size 5m;

    ssl_certificate     /etc/letsencrypt/live/TU_DOMINIO/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/TU_DOMINIO/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # API (prefijo global /api)
    location /api/ {
        proxy_pass http://boxit_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Front (Next.js) + PWA
    location / {
        proxy_pass http://boxit_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
