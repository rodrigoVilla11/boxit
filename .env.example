# ============================================================
# BOX iT — variables de entorno (copiá a .env y completá)
# ============================================================

# --- Base de datos (Postgres 17 via docker-compose) ---
POSTGRES_USER=boxit
POSTGRES_PASSWORD=boxit
POSTGRES_DB=boxit
# Puerto de host para Postgres (cambialo si el 5432 ya está ocupado).
POSTGRES_PORT=5432
# La API usa esta URL. En Docker prod, host = "db"; en dev local, "localhost".
# El puerto debe coincidir con POSTGRES_PORT de arriba.
DATABASE_URL=postgresql://boxit:boxit@localhost:5432/boxit?schema=public

# --- API (NestJS) ---
API_PORT=3001
# Origen del front habilitado para CORS con credentials (cookies)
CORS_ORIGIN=http://localhost:3000

# --- Auth JWT (Fase 2) ---
# Generá secrets fuertes, p. ej.: openssl rand -base64 48
JWT_SECRET=cambiame-access-secret
JWT_REFRESH_SECRET=cambiame-refresh-secret
JWT_ACCESS_TTL=900          # 15 min (segundos)
JWT_REFRESH_TTL=604800      # 7 días (segundos)

# --- Web (Next.js) ---
# URL de la API para el navegador (client-side). En prod: "" (mismo origen, Nginx proxya /api)
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL de la API para el server de Next (server components / SSR). En Docker prod: http://api:3001
API_INTERNAL_URL=http://localhost:3001
