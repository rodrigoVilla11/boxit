# Env del front (Next.js). Copiá a web/.env.local para desarrollo.
# Next lee estos archivos desde la carpeta web/, no desde la raíz del monorepo.

# URL de la API para el NAVEGADOR (client-side). Se embebe en el build.
# En prod: "" (mismo origen; Nginx proxya /api).
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL de la API para el SERVER de Next (SSR / server components).
# En Docker prod: http://api:3001
API_INTERNAL_URL=http://localhost:3001

# Clave pública VAPID para Web Push (debe coincidir con VAPID_PUBLIC_KEY de la API).
# Generá el par con: pnpm --filter api exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
